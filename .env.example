# Application Settings
APP_NAME="Mehr Life Time"
APP_ENV="development"
DEBUG=true
TIMEZONE="Asia/Tehran"

# Telegram Bot (Phase 1)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_USER_IDS="123456789"
TELEGRAM_ADMIN_CHAT_ID=

# Telegram user-account session used only to create per-user forum supergroups.
# Create an API app at my.telegram.org, then run scripts/authorize_telegram_account.py once.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_SESSION="data/telegram_creator.session.enc"
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TELEGRAM_SESSION_ENCRYPTION_KEY=
TELEGRAM_BOT_USERNAME=

# Database (Phase 2)
DATABASE_URL="sqlite:///data/mehr_life_time.db"

# LLM Configuration (Phase 8)
LLM_PROVIDER="ollama"
LLM_BASE_URL="http://localhost:11434"
LLM_MODEL_NAME="llama3"
